---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { labelForPath, pagePathForId } from "../lib/pages";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .filter((entry) => entry.id !== "index")
    .map((entry) => ({
      params: { slug: pagePathForId(entry.id).slice(1) },
      props: { entry },
    }));
}

const { entry } = Astro.props as {
  entry: CollectionEntry<"docs">;
};

const { Content } = await render(entry);
const currentPath = pagePathForId(entry.id);
const title = entry.data.title ?? labelForPath(currentPath);
---

<DocsLayout currentPath={currentPath} title={title} description={entry.data.description}>
  <Content />
</DocsLayout>