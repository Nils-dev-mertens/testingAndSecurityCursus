---
import { getEntry, render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";

const entry = await getEntry("docs", "index");
if (!entry) throw new Error("content/index.md is missing");
const { Content } = await render(entry);
const title = entry.data.title ?? "Home";
---

<DocsLayout currentPath="/" title={title} description={entry.data.description}>
  <Content />
</DocsLayout>